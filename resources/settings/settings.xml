<resources xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">

    <!--
        Phone-side settings (Garmin Connect Mobile / Garmin Express).
        These edit the *display* properties (raceDistanceDisplay in
        whichever unit distanceUnits selects, finishTimeMin in minutes) -
        AppBase.onSettingsChanged() converts them into the canonical
        raceDistanceM/finishTimeSec properties the watch app actually uses.
    -->
    <settings>
        <setting propertyKey="@Properties.distanceUnits" title="@Strings.unitsTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.unitsKm</listEntry>
                <listEntry value="1">@Strings.unitsMiles</listEntry>
            </settingConfig>
        </setting>

        <setting propertyKey="@Properties.raceDistanceDisplay" title="@Strings.distanceTitle">
            <settingConfig type="numeric" />
        </setting>

        <setting propertyKey="@Properties.finishTimeMin" title="@Strings.finishTimeTitle">
            <settingConfig type="numeric" />
        </setting>

        <!--
            Placement dropdowns: hidden / top row / bottom row per value.
            Max 3 per row - enforced on the watch, since these settings
            screens can't validate across fields.
        -->
        <setting propertyKey="@Properties.p0" title="@Strings.posCurrentTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.posHidden</listEntry>
                <listEntry value="1">@Strings.posTop</listEntry>
                <listEntry value="2">@Strings.posBottom</listEntry>
            </settingConfig>
        </setting>

        <setting propertyKey="@Properties.p1" title="@Strings.posAverageTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.posHidden</listEntry>
                <listEntry value="1">@Strings.posTop</listEntry>
                <listEntry value="2">@Strings.posBottom</listEntry>
            </settingConfig>
        </setting>

        <setting propertyKey="@Properties.p2" title="@Strings.posSplitTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.posHidden</listEntry>
                <listEntry value="1">@Strings.posTop</listEntry>
                <listEntry value="2">@Strings.posBottom</listEntry>
            </settingConfig>
        </setting>

        <setting propertyKey="@Properties.p3" title="@Strings.posTargetTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.posHidden</listEntry>
                <listEntry value="1">@Strings.posTop</listEntry>
                <listEntry value="2">@Strings.posBottom</listEntry>
            </settingConfig>
        </setting>

        <setting propertyKey="@Properties.p4" title="@Strings.posDeltaTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.posHidden</listEntry>
                <listEntry value="1">@Strings.posTop</listEntry>
                <listEntry value="2">@Strings.posBottom</listEntry>
            </settingConfig>
        </setting>

        <setting propertyKey="@Properties.p5" title="@Strings.posFinishDeltaTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.posHidden</listEntry>
                <listEntry value="1">@Strings.posTop</listEntry>
                <listEntry value="2">@Strings.posBottom</listEntry>
            </settingConfig>
        </setting>

        <setting propertyKey="@Properties.p6" title="@Strings.posFinishTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.posHidden</listEntry>
                <listEntry value="1">@Strings.posTop</listEntry>
                <listEntry value="2">@Strings.posBottom</listEntry>
            </settingConfig>
        </setting>

        <setting propertyKey="@Properties.p7" title="@Strings.posDistanceTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.posHidden</listEntry>
                <listEntry value="1">@Strings.posTop</listEntry>
                <listEntry value="2">@Strings.posBottom</listEntry>
            </settingConfig>
        </setting>

        <setting propertyKey="@Properties.p8" title="@Strings.posElapsedTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.posHidden</listEntry>
                <listEntry value="1">@Strings.posTop</listEntry>
                <listEntry value="2">@Strings.posBottom</listEntry>
            </settingConfig>
        </setting>

        <setting propertyKey="@Properties.p9" title="@Strings.posHeartRateTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.posHidden</listEntry>
                <listEntry value="1">@Strings.posTop</listEntry>
                <listEntry value="2">@Strings.posBottom</listEntry>
            </settingConfig>
        </setting>

        <setting propertyKey="@Properties.p10" title="@Strings.posAvgHeartRateTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.posHidden</listEntry>
                <listEntry value="1">@Strings.posTop</listEntry>
                <listEntry value="2">@Strings.posBottom</listEntry>
            </settingConfig>
        </setting>

        <setting propertyKey="@Properties.showProgressRing" title="@Strings.showProgressRingTitle">
            <settingConfig type="boolean" />
        </setting>

        <setting propertyKey="@Properties.showHeartRateArc" title="@Strings.showHeartRateArcTitle">
            <settingConfig type="boolean" />
        </setting>

        <setting propertyKey="@Properties.highlightDelta" title="@Strings.highlightDeltaTitle">
            <settingConfig type="boolean" />
        </setting>

        <setting propertyKey="@Properties.paceSmoothingM" title="@Strings.paceSmoothingTitle">
            <settingConfig type="list">
                <listEntry value="50">@Strings.smoothing50</listEntry>
                <listEntry value="100">@Strings.smoothing100</listEntry>
                <listEntry value="200">@Strings.smoothing200</listEntry>
            </settingConfig>
        </setting>

        <setting propertyKey="@Properties.backgroundMode" title="@Strings.backgroundModeTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.backgroundBlack</listEntry>
                <listEntry value="1">@Strings.backgroundWhite</listEntry>
            </settingConfig>
        </setting>

        <setting propertyKey="@Properties.alertsEnabled" title="@Strings.alertsEnabledTitle">
            <settingConfig type="boolean" />
        </setting>

        <setting propertyKey="@Properties.alertBehindThresholdSec" title="@Strings.alertThresholdTitle">
            <settingConfig type="list">
                <listEntry value="15">@Strings.alertThreshold15</listEntry>
                <listEntry value="30">@Strings.alertThreshold30</listEntry>
                <listEntry value="60">@Strings.alertThreshold60</listEntry>
            </settingConfig>
        </setting>
    </settings>

</resources>
