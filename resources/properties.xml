<resources xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">

    <!--
        Shared property definitions for RacePaceField and RacePaceWidget.
        Both apps declare the SAME property ids/types here so their
        values interoperate: Garmin Connect Mobile, Garmin Express, and
        each app's own on-device settings all read/write the same keys.
        Canonical units: distance in meters, time in seconds.
    -->
    <properties>
        <property id="raceDistanceM" type="float">5000.0</property>
        <property id="finishTimeSec" type="number">1800</property>
        <property id="distanceUnits" type="number">0</property>

        <!--
            Phone-facing mirrors of the canonical properties above, shown
            in Garmin Connect Mobile/Express (which can only show plain
            numeric fields, not the on-watch H/M/S or unit-aware pickers).
            raceDistanceDisplay is in whichever unit distanceUnits selects
            (km or miles); finishTimeMin is in minutes. AppBase.onSettingsChanged()
            converts these into the canonical meters/seconds properties.
        -->
        <property id="raceDistanceDisplay" type="float">5.0</property>
        <property id="finishTimeMin" type="number">30</property>

        <!--
            Where each value shows: 0 = hidden, 1 = top row, 2 = bottom
            row (Garmin Connect Mobile/Express only - not exposed
            on-device, since the watch's own settings menu is for race
            parameters, not layout). Each row holds at most 3 values;
            extras are dropped in a fixed order and the watch shows a
            warning (see RacePaceCalc.buildRows()). Keyed p<ITEM_* id>
            (short to save memory on 32 KB watches). Hidden values free
            their space for whatever's left. Defaults match the original
            layout: Current / Average / Ahead-Behind on top, Projected
            Finish below.
        -->
        <property id="p0" type="number">1</property> <!-- Current Pace -->
        <property id="p1" type="number">1</property> <!-- Average Pace -->
        <property id="p2" type="number">0</property> <!-- Km/Mi Split Pace -->
        <property id="p3" type="number">0</property> <!-- Target Pace -->
        <property id="p4" type="number">1</property> <!-- Ahead/Behind -->
        <property id="p5" type="number">0</property> <!-- Finish +/- -->
        <property id="p6" type="number">2</property> <!-- Projected Finish -->
        <property id="p7" type="number">0</property> <!-- Distance -->
        <property id="p8" type="number">0</property> <!-- Elapsed Time -->
        <property id="p9" type="number">0</property> <!-- Heart Rate -->
        <property id="p10" type="number">0</property> <!-- Average Heart Rate -->

        <!--
            Race progress ring around the screen edge, with a marker for
            where goal pace would have you. On by default. Only drawn
            when the field fills the whole (round) screen.
        -->
        <property id="showProgressRing" type="boolean">true</property>

        <!--
            Heart rate zone arc around the bottom half of the screen, with
            a marker at your current heart rate. When on, the progress
            ring shrinks to the top half to make room. Full round screens
            only (not the 32 KB lite watches). On by default.
        -->
        <property id="showHeartRateArc" type="boolean">true</property>

        <!-- Ahead/Behind and Finish +/- in a filled green/red box. Off by default. -->
        <property id="highlightDelta" type="boolean">false</property>

        <!--
            Current-pace smoothing window, in meters. Phone-configured
            only - it's a display-smoothing preference, not a race
            parameter, so it doesn't belong on the watch's own race-setup
            menu (Race Distance / Finish Time / Units).
        -->
        <property id="paceSmoothingM" type="number">100</property>

        <!--
            Forces the field's background to black or white, regardless
            of the watch's own field/theme background. Phone-configured
            only. Defaults to black (0).
        -->
        <property id="backgroundMode" type="number">0</property>

        <!--
            On-device pace alerts (RacePaceFieldView.compute()). Off by
            default - opt-in. alertBehindThresholdSec is how long
            continuously behind target pace before the first alert
            fires; repeat alerts (every 60s) and the 5-minute alert
            cutoff are fixed in code, not configurable.
        -->
        <property id="alertsEnabled" type="boolean">false</property>
        <property id="alertBehindThresholdSec" type="number">15</property>
    </properties>

</resources>
