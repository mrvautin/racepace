project.manifest = manifest.xml

# Shared code is in source/. Most watches use the full screen in
# source-full/. Watches that give data fields only 32 KB of memory use
# the simpler screen in source-lite/, because the full one runs out of
# memory there.
base.sourcePath = source;source-full
vivoactive4.sourcePath = source;source-lite
vivoactive4s.sourcePath = source;source-lite
fr245.sourcePath = source;source-lite
fenix6.sourcePath = source;source-lite
fenix6s.sourcePath = source;source-lite
enduro.sourcePath = source;source-lite
